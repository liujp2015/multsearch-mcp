# multsearch-mcp 环境变量示例
# 复制为 .env 或填进 .mcp.json 的 env 段。请勿把真实 key 提交进 git。

# ── 主 LLM（必需）── 火山方舟 Ark glm-5.2，国内直连
MULT_PROVIDER=custom
MULT_API_URL=https://ark.cn-beijing.volces.com/api/plan/v3
MULT_API_KEY=ark-your-ark-key
MULT_MODEL=glm-5.2
MULT_MAX_TOKENS=8192

# ── Tavily（可选 · web_search 找源 + web_fetch/web_map）──
TAVILY_API_KEY=tvly-your-tavily-key

# ── Firecrawl（可选 · web_search 找源 + web_fetch 兜底）──
FIRECRAWL_API_KEY=fc-your-firecrawl-key

# ── Gemini（可选 · gemini_search 第二路 Google 索引）──
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# ── 代理（中国大陆：Tavily/Firecrawl/Gemini 走代理，Ark 走 NO_PROXY 直连）──
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,::1,ark.cn-beijing.volces.com,*.volces.com,*.aliyuncs.com,open.bigmodel.cn

# ── 调试 / 日志（可选）──
# MULT_DEBUG=false
# MULT_LOG_LEVEL=INFO
# MULT_LOG_DIR=~/.config/multsearch/logs
